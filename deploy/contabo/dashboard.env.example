GOOGLE_APPLICATION_CREDENTIALS=/opt/fixmypresence/secrets/google-service-account.json

# Bind to 127.0.0.1 if you will place nginx/Caddy in front.
# Change to 0.0.0.0 if you want to expose the dashboard directly.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_RELOAD=0
DASHBOARD_USE_XVFB=1
XVFB_DISPLAY=:99
XVFB_SCREEN=1920x1080x24

# Production-style cycle defaults. Adjust if you want different timings.
CYCLE_RUN_MINUTES=240
CYCLE_REST_MINUTES=120

PYTHONUNBUFFERED=1
